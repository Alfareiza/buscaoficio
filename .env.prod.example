# DRAFT — infra-level env vars consumed by docker-compose.prod.yml itself
# (Caddy's DOMAIN/API_DOMAIN/ACME_EMAIL). This is separate from the app-level
# fastapi_backend/.env and nextjs-frontend/.env files, which follow the
# existing fastapi_backend/.env.example and nextjs-frontend/.env.example
# templates with production values.
#
# On the EC2 box: copy this to ./.env (same directory as docker-compose.prod.yml)
# and fill in real values. Never commit the filled-in ./.env file.

# Public hostname for the Next.js frontend
DOMAIN=app.buscaoficio.co

# Public hostname for the FastAPI backend (serves /admin, /api/v1, /docs)
API_DOMAIN=api.buscaoficio.co

# Email Caddy registers with Let's Encrypt for certificate expiry notices.
# Deliberately a Gmail address, not an @buscaoficio.co one: the only mailbox on
# that domain is contacto@buscaoficio.co (used as MAIL_FROM for OTP sends), and
# cert-expiry notices shouldn't land in a user-facing inbox.
ACME_EMAIL=buscaoficio.co@gmail.com

# Pre-built images pulled from ECR (built + pushed by GitHub Actions, tagged with
# the git SHA of the commit that triggered the build). The deploy workflow
# rewrites these two lines in place on the box; never set them to ":latest" here.
BACKEND_IMAGE=502993831706.dkr.ecr.us-east-1.amazonaws.com/buscaoficio-backend:<git-sha>
FRONTEND_IMAGE=502993831706.dkr.ecr.us-east-1.amazonaws.com/buscaoficio-frontend:<git-sha>
