# Local database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5434/buscaoficio

# Test database
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5435/testdatabase

# Secret keys
ACCESS_SECRET_KEY=your_access_secret_key
RESET_PASSWORD_SECRET_KEY=your_reset_password_secret_key
VERIFICATION_SECRET_KEY=your_verification_secret_key
REGISTRATION_TOKEN_SECRET_KEY=your_registration_token_secret_key

# OpenAPI genrated file output path
OPENAPI_OUTPUT_FILE=../nextjs-frontend/openapi.json

# Localhost Email configuration
MAIL_USERNAME=test
MAIL_PASSWORD=test
MAIL_FROM=test@test.com
MAIL_PORT=1025
MAIL_SERVER=localhost
MAIL_STARTTLS=False
MAIL_SSL_TLS=False
USE_CREDENTIALS=False

# Frontend (NextJS)
FRONTEND_URL=http://localhost:3000

# Backend's own public base URL (must match the redirect URI registered in
# Google Cloud Console for Google Sign-In). In production: https://api.buscaoficio.co
# — the Google Cloud Console client must have BOTH this and the localhost value
# above registered as authorized redirect URIs (append /api/v1/auth/google/callback
# to each) if the same OAuth client is reused across environments.
BACKEND_URL=http://localhost:8001

# Google Sign-In (OAuth 2.0 client from Google Cloud Console; leave blank to
# disable — the /auth/google/* routes respond 501 without these). Same client
# ID/secret can be reused between local dev and production as long as both
# redirect URIs (see BACKEND_URL above) are registered on it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# CORS (Allow all origins for development; adjust this to restrict origins in production deployments)
CORS_ORIGINS=["*"]

# OPENAPI (Uncomment the line below to disable the /docs and openapi.json urls)
# OPENAPI_URL=""

# FastAdmin (logo values are URL paths served by FastAPI at /static, not filesystem paths)
ADMIN_USER_MODEL=User
ADMIN_USER_MODEL_USERNAME_FIELD=email
ADMIN_SECRET_KEY=your_admin_secret_key
ADMIN_SITE_NAME=BuscaOficio Admin
ADMIN_SITE_HEADER_LOGO=/static/images/logo/busca-oficio-logo-principal.svg
ADMIN_SITE_SIGN_IN_LOGO=/static/images/logo/busca-oficio-logo-principal.svg
ADMIN_SESSION_COOKIE_SECURE=false

# Sentry (leave empty to disable locally)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development