# Backend API base URL
API_BASE_URL=http://localhost:8001

# This app's own public origin — required in production (behind a reverse
# proxy, request.url resolves to the standalone server's bind address, not
# the public domain). Leave unset locally; request.url is reliable there.
FRONTEND_URL=

# OpenAPI generated file name (relative to the frontend directory)
OPENAPI_OUTPUT_FILE=openapi.json

# Sentry (leave empty to disable locally)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=