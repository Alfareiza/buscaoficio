# Production frontend image. Built in CI, pulled on the EC2 box — never
# built there (913MB RAM). Runner is alpine + Next standalone; builder
# keeps pnpm, devDependencies, and .next/cache and is discarded.

FROM node:20-alpine AS builder
WORKDIR /app
# sharp / native addons on alpine need this; without it `pnpm build` fails.
RUN apk add --no-cache libc6-compat

# Corepack (bundled with Node 20) reads packageManager below and installs
# that exact, hash-verified pnpm version. `npm install -g pnpm` (no version
# pin) always fetched latest, which broke this build the day pnpm shipped a
# stricter engine-identity check this repo's lockfile predates.
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && corepack prepare --activate
RUN pnpm install --frozen-lockfile

# openapi-client is committed; no backend/watcher needed at build time.
COPY . .

# Sourcemap upload only (Sentry webpack plugin). CI passes this as a
# build-arg; it does not land in the runner image.
ARG SENTRY_AUTH_TOKEN
ENV SENTRY_AUTH_TOKEN=${SENTRY_AUTH_TOKEN}

RUN pnpm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
# Standalone defaults to localhost; Caddy on app_network could not reach it.
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
